# Copy this file to .env and adjust as needed. All values have safe local defaults.

# SQLite database file location
GUARDRAIL_DB_PATH=./guardrail.db

# Path to the policy YAML
GUARDRAIL_POLICY_PATH=./policies/policies.yaml

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Optional - only needed if you enable the (optional, disabled by default)
# LLM-assisted policy explanation feature. The core guardrail works without it.
OPENAI_API_KEY=
